<div class="p-8 space-y-5"><h1 class="text-3xl">Invoices and credit notes</h1><a class="btn" href="/admin/invoicing">Settings</a><p class="text-sm/6">Latest 200 documents. Open a document to download, review missing details or retry delivery.</p>
<table class="table"><thead><tr><th>Number</th><th>Kind</th><th>Status</th><th>Email submitted</th><th>Created</th></tr></thead><tbody>
{{ range .documents }}<tr><td><a class="link" href="/admin/invoices/{{ .id }}">{{ if .number }}{{ .number }}{{ else }}Awaiting issuance{{ end }}</a></td><td>{{ .kind }}</td><td>{{ .status }} {{ .last_error }}</td><td>{{ if .email_submitted }}Submitted{{ else }}Not submitted{{ end }}</td><td>{{ .created_at }}</td></tr>{{ end }}
</tbody></table></div>

{{ $fieldIndex := .}}
{{ if .fieldIndex }}
{{ $fieldIndex = .fieldIndex }}
{{ else }}
{{ $fieldIndex = 0 }}
{{ end }}
{{ $pg := "paypal" }}
{{ $data := .}}
{{ set $data "fieldIndex" $fieldIndex}}
{{ set $data "pg" $pg}}

<div
  id="price_fields_{{ $fieldIndex }}"
  class="flex flex-col gap-3 sm:flex-row sm:flex-nowrap sm:items-start"
>
  {{ template "products/views/countries.html.got" $data}}

  <input
    type="number"
    name="{{ $pg }}_amount_{{ $fieldIndex }}"
    id="{{ $pg }}_amount_{{ $fieldIndex }}"
    placeholder="Amount"
    class="input min-w-0 sm:flex-1 w-full rounded-sm max-w-42 prose lg:prose-xl"
    required
    _="on click or input
      if value of #{{ $pg }}_country_{{
      $fieldIndex
    }} is equal to 'Select Country'
        call #{{ $pg }}_country_{{ $fieldIndex }}.focus()
        then call Swal.fire({text:'Select a country first',   theme:'auto'})
      end
      "
  />

    <div class="w-full min-w-0 max-w-24 sm:flex-1" hx-post="/products/gst-tax/{{ $fieldIndex }}" hx-trigger="load, gstPricingChanged from:body, change from:#{{ $pg }}_amount_{{ $fieldIndex }}, change from:#{{ $pg }}_currency_{{ $fieldIndex }}, change from:#{{ $pg }}_country_{{ $fieldIndex }}" hx-include="this, [name^='gst_'], #{{ $pg }}_amount_{{ $fieldIndex }}, #{{ $pg }}_currency_{{ $fieldIndex }}, #{{ $pg }}_country_{{ $fieldIndex }}" hx-swap="innerHTML"><input
    type="number"
    name="{{ $pg }}_tax_{{ $fieldIndex }}"
    id="{{ $pg }}_tax_{{ $fieldIndex }}"
    placeholder="Tax"
    class="input min-w-0 sm:flex-1 w-full rounded-sm max-w-24 prose lg:prose-xl"
    required
    _="on click or input
    if value of #{{ $pg }}_country_{{
      $fieldIndex
    }} is equal to 'Select Country'
      call #{{ $pg }}_country_{{ $fieldIndex }}.focus()
      then call Swal.fire({text:'Select a country first',   theme:'auto'})
    else if value of #{{ $pg }}_amount_{{ $fieldIndex }} is empty
      call #{{ $pg }}_amount_{{ $fieldIndex }}.focus()
      then call Swal.fire({text:'Set a amount first',   theme:'auto'})
    end
      "
  /></div>

  <input
    type="text"
    name="{{ $pg }}_currency_{{ $fieldIndex }}"
    id="{{ $pg }}_currency_{{ $fieldIndex }}"
    placeholder="USD"
    class="input min-w-0 sm:flex-1 w-full rounded-sm max-w-24 prose lg:prose-xl"
    required
    _="on click or input
    if value of #{{ $pg }}_country_{{
      $fieldIndex
    }} is equal to 'Select Country'
      call #{{ $pg }}_country_{{ $fieldIndex }}.focus()
      then call Swal.fire({text:'Select a country first',   theme:'auto'})
    else if value of #{{ $pg }}_amount_{{ $fieldIndex }} is empty
      call #{{ $pg }}_amount_{{ $fieldIndex }}.focus()
      then call Swal.fire({text:'Set a amount first',   theme:'auto'})
    else if value of #{{ $pg }}_tax_{{ $fieldIndex }} is empty
      call #{{ $pg }}_tax_{{ $fieldIndex }}.focus()
      then call Swal.fire({text:'Set a tax first',   theme:'auto'})
    end
    "
  />

  {{ if gt $fieldIndex 0}}
  <div class="flex shrink-0">
    <button
      _="on click halt the event default call Swal.fire({ theme: 'auto', title: 'Are you sure?', text: 'You won\'t be able to revert this!', icon: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'})
    if result.isConfirmed then remove #price_fields_{{ $fieldIndex }} end "
      class="btn rounded-sm"
    >
      &minus;
    </button>
  </div>
  {{ end }}
</div>
<div id="price-field-buttons-{{ $pg }}" class="flex">
  <button
    id="price_add_country_{{ $fieldIndex }}"
    class="btn"
    hx-get="/products/create/price/{{ $fieldIndex }}/{{ $pg }}/{{ $.schedule }}"
    hx-target="#price-field-buttons-{{ $pg }}"
    hx-swap="outerHTML"
  >
    Add Country
  </button>
</div>
